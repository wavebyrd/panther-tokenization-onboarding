# Optional: your own connections. Everything works without these, but the free
# public endpoints are rate-limited. Copy to .env.local and fill in what you have.
# Keys stay on the server and are never sent to the browser.

# RPC URLs per chain, comma-separated, tried before the public ones.
# PTO_RPC_ETHEREUM=https://eth-mainnet.example.com/v2/your-key
# PTO_RPC_BASE=
# PTO_RPC_ARBITRUM=
# PTO_RPC_BSC=
# PTO_RPC_SOLANA=
# PTO_RPC_ROBINHOOD=

# A Jupiter API key (Solana quotes). Without it, the free lite endpoint is used.
# PTO_JUPITER_API_KEY=

# The client id sent to KyberSwap's aggregator (EVM quotes).
# PTO_KYBERSWAP_CLIENT_ID=
