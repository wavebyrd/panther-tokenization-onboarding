{
  "name": "panther-tokenization-onboarding",
  "version": "0.1.0",
  "private": true,
  "description": "Educational portfolio simulator for tokenized assets: mean-variance allocation, a glide path, and live checks of where each order fills best on chain.",
  "scripts": {
    "dev": "next dev --port 3400",
    "build": "next build",
    "start": "next start --port 3400",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "dev:widget": "vite --config vite.widget.config.ts",
    "build:widget": "vite build --config vite.widget.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.9.3",
    "vite": "^6.3.5"
  }
}
